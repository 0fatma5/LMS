@{
    ViewData["Title"] = "About Us";
}

<section class="hero-section" style="padding-top: 150px; padding-bottom: 80px; background: radial-gradient(circle at 70% 50%, #2e1a5e 0%, #100529 100%);">
    <div class="container">
        <div class="hero-text text-center">
            <h2 style="font-size: 3rem; font-weight: 700; color: #fff;">About Us</h2>
        </div>
    </div>
</section>

<section class="about-section">
    <div class="container about-grid">
        <div class="about-images">
            <div class="img-big">
                <img src="~/images/about.jpg" alt="About Us">
            </div>
        </div>

        <div class="about-content">
            <span class="tag-pill">Who We Are</span>
            <h2>Welcome to the <span class="underline-style">Online</span> <br> Learning Center</h2>
            <p class="lead-text">Meet my startup design agency Shape Rex Currently I am working at CodeNext as Product Designer.</p>

            <h3>10+ Years Experience In Product Designing</h3>

            <p style="color: #6D6D6D; margin-top: 15px;">
                I love to work in User Experience & User Interface designing.
                Because I love to solve the design problem and find easy and
                better solutions to solve it. I always try my best to make good user
                interface with the best user experience.
            </p>

            <div class="stats-row">
                <div class="stat-item">
                    <i class="fas fa-user-graduate"></i>
                    <div>
                        <h3>25K+</h3>
                        <p>Students</p>
                    </div>
                </div>
                <div class="stat-item">
                    <i class="fas fa-chalkboard-teacher"></i>
                    <div>
                        <h3>100+</h3>
                        <p>Teachers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

