@model LMS.Models.Subject

@{
    ViewData["Title"] = "Create Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container course-form-page">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="course-form-card">

                <div class="form-header">
                    <h2>
                        <i class="fas fa-plus-circle"></i> Create New Course
                    </h2>
                </div>

                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="Name">Course Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Web Development Bootcamp" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="What will students learn in this course?"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Price">Price ($)</label>
                                <input asp-for="Price" type="number" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="control-label">Category</label>
                                <input type="text" name="CategoryNameInput" class="form-control" list="categoriesList" placeholder="e.g. Programming" required />

                                <datalist id="categoriesList">
                                    @if (ViewBag.ExistingCategories != null)
                                    {
                                        @foreach (var cat in ViewBag.ExistingCategories)
                                        {
                                            <option value="@cat.Name"></option>
                                        }
                                    }
                                </datalist>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ColorClass">Card Color Theme</label>
                        <select asp-for="ColorClass" class="form-control">
                            <option value="bg-purple">Purple (Default)</option>
                            <option value="bg-pink">Pink (Design)</option>
                            <option value="bg-green">Green (Data)</option>
                            <option value="bg-orange">Orange (Business)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Course Image</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" style="padding: 12px 35px;">
                            <i class="fas fa-check"></i> Create Course
                        </button>
                        <a asp-action="Index" class="btn btn-white" style="border: 1px solid #ddd; padding: 12px 25px;">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>