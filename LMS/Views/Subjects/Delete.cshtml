@model LMS.Models.Subject

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding-top: 150px; padding-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h3 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Delete Confirmation</h3>
                </div>

                <div class="card-body p-5 text-center">
                    <h4 class="text-secondary mb-3">Are you sure?</h4>
                    <p class="text-muted mb-4">
                        You are about to permanently delete the course:
                        <br>
                        <strong class="text-dark" style="font-size: 1.2rem;">"@Model.Name"</strong>
                    </p>

                    <div class="alert alert-light border">
                        <small class="d-block text-muted">Category: @Model.Category?.Name</small>
                        <small class="d-block text-muted">Price: $@Model.Price</small>
                    </div>

                    <p class="text-danger small">⚠️ This action cannot be undone.</p>

                    <form asp-action="Delete" method="post" class="mt-4 d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="Id" />

                        <a asp-action="Index" class="btn btn-light border px-4">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Yes, Delete it
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>