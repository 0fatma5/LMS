@model IEnumerable<LMS.Models.Subject>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}

<section class="profile-hero" style="background-image: url('/images/backteach.jpeg'); background-size: cover; height: 230px;"></section>

<div class="profile-card container" style="margin-top: -80px; position: relative; z-index: 10;">
    <div class="profile-info">
        <h2 style="text-transform: capitalize;">@userName</h2>
        <p style="color: var(--primary-color); font-weight: 600;">Certified Teacher 🧑‍🏫</p>

        <div style="margin-top: 20px;">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle"></i> Create New Course
            </a>
        </div>
    </div>

    <img src="~/images/logo.jpg" class="profile-img" alt="Profile Image">
</div>

<div class="container courses-container" style="margin-top: 50px; margin-bottom: 100px;">

    <h3 class="courses-title">My Created Courses <span style="font-size:0.8em; color:#888;">(@Model.Count())</span></h3>

    @if (!Model.Any())
    {
        <div class="text-center" style="padding: 50px; color: #777;">
            <h3>No courses created yet! 📭</h3>
            <p>Start your journey by clicking the "Create New Course" button above.</p>
        </div>
    }
    else
    {
        <div class="courses-grid">
            @foreach (var item in Model)
            {
                <div class="course-card" style="position: relative;">

                    @if (item.Category != null)
                    {
                        <div class="course-type" style="position: absolute; top: 20px; left: 20px; z-index: 2; padding: 5px 15px; border-radius: 20px; background-color: #6f42c1; color: white; font-size: 0.8rem; font-weight: 600;">
                            @item.Category.Name
                        </div>
                    }
                    else
                    {
                        <div class="course-type" style="position: absolute; top: 20px; left: 20px; z-index: 2; padding: 5px 15px; border-radius: 20px; background-color: #6c757d; color: white; font-size: 0.8rem; font-weight: 600;">
                            General
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="~/images/@item.ImageUrl" alt="@item.Name" style="height: 180px; width: 100%; object-fit: cover; border-radius: 10px;">
                    }
                    else
                    {
                        <img src="~/images/default-course.jpg" alt="Default" style="height: 180px; width: 100%; object-fit: cover; border-radius: 10px;">
                    }

                    <h4 style="margin-top: 15px; font-weight: 700;">@item.Name</h4>

                    <div class="course-meta">
                        <span><i class="fas fa-book-open"></i> Premium Course</span>
                    </div>

                    <p style="font-size: 0.9rem; color: #666; margin: 10px 0;">
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            @(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                        }
                    </p>

                    <div class="course-price">
                        <strong>$@item.Price</strong>
                        <span class="old" style="text-decoration: line-through; color: #aaa; margin-left: 5px;">$@(item.Price + 20)</span>
                    </div>

                    <div style="margin-top: 15px; padding: 0 5px;">
                        <a asp-controller="Subjects" asp-action="ManageContent" asp-route-id="@item.Id"
                           style="display: block; width: 100%; text-align: center; background-color: #f3f0ff; color: #6366f1; padding: 10px 0; border-radius: 8px; font-weight: 700; text-decoration: none; border: 1px dashed #6366f1; transition: 0.3s;"
                           onmouseover="this.style.backgroundColor='#6366f1'; this.style.color='white';"
                           onmouseout="this.style.backgroundColor='#f3f0ff'; this.style.color='#6366f1';">
                            <i class="fas fa-layer-group"></i> Manage Content
                        </a>
                    </div>

                    <div class="course-actions" style="margin-top: 10px; display: flex; gap: 10px;">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn" style="flex: 1; background-color: #2e1a5e; color: white; padding: 8px; text-align: center; border-radius: 5px; font-size: 0.9rem;">
                            <i class="fas fa-edit"></i> Edit Info
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Delete">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var successMsg = '@TempData["SuccessMessage"]';
        if (successMsg) {
            Swal.fire({
                title: 'Great Job!',
                text: successMsg,
                icon: 'success',
                confirmButtonColor: '#5D3CF2',
                confirmButtonText: 'Done'
            });
        }
    </script>
}