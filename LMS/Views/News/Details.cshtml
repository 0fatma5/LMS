@model LMS.Models.News

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="single-hero">
    <div class="container">
        <h1>@Model.Title</h1>
    </div>
</section>

<main class="content-area">
    <div class="container blog-detail-layout">

        <article class="single-post-content">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/images/news/@Model.ImageUrl" alt="@Model.Title" class="featured-image">
            }

            <div class="post-meta">
                <span><i class="far fa-user-circle"></i> by @Model.Author</span>
                <span><i class="far fa-clock"></i> @Model.PublishedDate.ToString("MMM dd, yyyy")</span>
                <span><i class="fas fa-tag"></i> @Model.Category</span>
            </div>

            <div class="entry-content">
                <p>@Model.Description</p>
            </div>

            <div style="margin-top: 30px;">
                <a asp-action="Index" class="btn btn-primary" style="border-radius:5px;">
                    <i class="fas fa-arrow-left"></i> Back to News
                </a>
            </div>
        </article>

        <aside class="sidebar">
            <div class="widget">
                <h4 class="widget-title">Categories</h4>
                <ul class="cat-list">
                    <li><span>Technology</span></li>
                    <li><span>Business</span></li>
                    <li><span>Story</span></li>
                    <li><span>Education</span></li>
                </ul>
            </div>
        </aside>

    </div>
</main>