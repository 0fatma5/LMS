@model LMS.Models.News

@{
    ViewData["Title"] = "Edit News";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding-top: 160px; padding-bottom: 100px; background-color: #f9f9ff; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="course-form-card" style="background: #fff; border-radius: 20px; padding: 50px; box-shadow: 0 15px 50px rgba(0,0,0,0.05);">

                <div class="form-header" style="margin-bottom: 30px; border-bottom: 2px solid #f5f5f5; padding-bottom: 20px;">
                    <h2 style="font-size: 1.8rem; font-weight: 700; color: var(--secondary-color);">
                        <i class="fas fa-edit" style="color: var(--primary-color);"></i> Edit Article
                    </h2>
                </div>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <input type="hidden" asp-for="PublishedDate" />

                    <div class="form-group mb-4">
                        <label asp-for="Title" style="font-weight: 600; margin-bottom: 10px; display: block;">Article Title</label>
                        <input asp-for="Title" class="form-control" style="padding: 14px 20px; border-radius: 12px; border: 1px solid #e6e6e6; background-color: #fcfcfc;" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Category" style="font-weight: 600; margin-bottom: 10px; display: block;">Category</label>
                            <select asp-for="Category" class="form-control" style="padding: 14px 20px; border-radius: 12px;">
                                <option value="Technology">Technology</option>
                                <option value="Business">Business</option>
                                <option value="Education">Education</option>
                                <option value="Stories">Stories</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Author" style="font-weight: 600; margin-bottom: 10px; display: block;">Author</label>
                            <input asp-for="Author" class="form-control" style="padding: 14px 20px; border-radius: 12px;" />
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" style="font-weight: 600; margin-bottom: 10px; display: block;">Content</label>
                        <textarea asp-for="Description" class="form-control" rows="8" style="padding: 14px 20px; border-radius: 12px; border: 1px solid #e6e6e6; background-color: #fcfcfc;"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label style="font-weight: 600; margin-bottom: 10px; display: block;">Featured Image</label>
                        <input type="file" name="imageFile" class="form-control" style="padding: 12px;" />

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-3 p-3 bg-light border rounded text-center">
                                <small class="text-muted d-block mb-2">Current Image:</small>
                                <img src="~/images/news/@Model.ImageUrl" width="200" style="border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                            </div>
                        }
                    </div>

                    <div class="form-actions" style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #f5f5f5; display: flex; gap: 15px;">
                        <button type="submit" class="btn btn-primary" style="padding: 12px 35px;">Save Changes</button>
                        <a asp-action="Index" class="btn btn-white" style="border: 1px solid #ddd; padding: 12px 25px;">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>